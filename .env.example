# Copie para .env (não versionado) e preencha localmente.

# Certificado digital A1 (ICP-Brasil) para assinatura de NFC-e — ver
# CLAUDE.md e internal/fiscal/certificado.go.
# FISCAL_CERT_HOST_PATH: caminho do .pfx/.p12 na sua máquina (host).
# FISCAL_CERT_PATH: caminho correspondente DENTRO do container (ex: /certs/certificado.pfx).
FISCAL_CERT_HOST_PATH=
FISCAL_CERT_PATH=/certs/certificado.pfx
FISCAL_CERT_SENHA=
