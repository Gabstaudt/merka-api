# Copie para .env (não versionado) e preencha localmente.

# Certificado digital A1 (ICP-Brasil) para assinatura de NFC-e — ver
# CLAUDE.md e internal/fiscal/certificado.go.
# FISCAL_CERT_HOST_PATH: caminho do .pfx/.p12 na sua máquina (host).
# FISCAL_CERT_PATH: caminho correspondente DENTRO do container (ex: /certs/certificado.pfx).
FISCAL_CERT_HOST_PATH=
FISCAL_CERT_PATH=/certs/certificado.pfx
FISCAL_CERT_SENHA=

# FISCAL_PROVIDER: "mock" (padrão — não fala com a SEFAZ, sempre emite
# com sucesso) ou "sefaz" (integração direta, ETAPA 4). Voltar pra "mock"
# é a forma rápida de desligar a integração real sem deploy, se travar em
# produção.
FISCAL_PROVIDER=mock

# FISCAL_AMBIENTE: "homologacao" (padrão, tpAmb=2) ou "producao" (tpAmb=1)
# — só relevante quando FISCAL_PROVIDER=sefaz.
FISCAL_AMBIENTE=homologacao

# FISCAL_SEFAZ_TIMEOUT_SEGUNDOS: quanto tempo esperar a SEFAZ responder
# antes de considerar indisponível (padrão 8s, janela recomendada 5-10s)
# — é esse timeout que decide quando o sistema cai pra contingência
# offline (tpEmis=9, Passo 6 ETAPA A/B). Baixar esse valor pra simular
# indisponibilidade em teste manual (ex: 1) contra a URL real de
# homologação, que não deve responder tão rápido.
FISCAL_SEFAZ_TIMEOUT_SEGUNDOS=8
