                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.fecharPagamentoResponse"
                        }
                    },
                    "400": {
                        "description": "corpo inválido, método inválido ou soma dos pagamentos não bate com o total",
                        "schema": {
                            "type": "object",
