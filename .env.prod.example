# Copie para .env.prod (não versionado — ver .gitignore) e preencha
# antes do primeiro deploy. Ver docs/deploy.md pro passo a passo
# completo. NUNCA reaproveite valores do .env de desenvolvimento —
# principalmente JWT_SECRET: o valor padrão de dev
# ("dev-secret-trocar-em-producao") existe justamente pra ser óbvio que
# precisa ser trocado, e está público neste repositório.

# --- Banco de dados ---
# Gere uma senha forte só pra produção (ex: `openssl rand -base64 24`) —
# nunca "merka"/"merka" do dev.
POSTGRES_USER=merka
POSTGRES_PASSWORD=
POSTGRES_DB=merka

# --- Autenticação ---
# Segredo usado pra assinar/validar os JWTs emitidos em POST /auth/login.
# Gere com `openssl rand -base64 48` — nunca reaproveite entre
# dev/homologação/produção, e nunca reaproveite se algum dia suspeitar
# de vazamento (trocar invalida todos os tokens emitidos até então, o
# que é o comportamento desejado numa suspeita de comprometimento).
JWT_SECRET=

# --- Fiscal (integração direta SEFAZ — ver CLAUDE.md) ---
# FISCAL_CERT_HOST_PATH: caminho do .pfx/.p12 real na VPS (fora do
# repositório, nunca commitado — ver .gitignore). FISCAL_CERT_PATH é o
# caminho correspondente DENTRO do container onde o volume é montado
# (ver docker-compose.prod.yml).
FISCAL_CERT_HOST_PATH=
FISCAL_CERT_PATH=/certs/certificado.pfx
FISCAL_CERT_SENHA=

# mock (nunca em produção de verdade) | sefaz
FISCAL_PROVIDER=sefaz
# homologacao (pra validar o deploy antes de emitir nota real) | producao
FISCAL_AMBIENTE=homologacao
FISCAL_SEFAZ_TIMEOUT_SEGUNDOS=8

# --- TLS / domínio (usado por scripts/init-letsencrypt.sh, não pela API) ---
DOMAIN=
LETSENCRYPT_EMAIL=
