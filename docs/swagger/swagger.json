                    "500": {
                        "description": "erro interno",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/comandas/{id}/itens": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
