                    {
                        "type": "string",
                        "description": "ID da comanda",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Produto e quantidade",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.lancarItemRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
